<% content_for :title, t('tasks.index.title') %>

<div class="page-header">
  <div class="container">
    <div>
      <div class="text-sm text-muted mb-1">
        <%= link_to @project.name, project_path(@project) %> /
      </div>
      <h1 class="page-title"><%= t('tasks.index.title') || "Project Tasks" %></h1>
      <p class="page-subtitle">
        <%= t('tasks.index.subtitle') || "View, manage and track all tasks for this project" %>
      </p>
    </div>
    <div class="page-actions flex gap-3">
      <%= link_to t('actions.back'), project_path(@project), class: 'btn btn-outline' %>
      <% if current_user.can_contribute_to?(@project) %>
        <%= link_to t('tasks.new.title') || "New Task", new_project_task_path(@project), class: 'btn btn-amber' %>
      <% end %>
    </div>
  </div>
</div>

<div class="page-content">
  <div class="container-sm">
    <% if @tasks.present? %>
      <div class="card">
        <div class="card-header">
          <h2 class="card-title flex items-center justify-between">
            <%= t('tasks.list') || "Tasks" %>
            <span class="text-sm font-normal text-muted">(<%= @tasks.count %>)</span>
          </h2>
        </div>
        <div class="card-body">
          <ul class="divide-y divide-gray-200">
            <% @tasks.each do |task| %>
              <li class="py-4 flex items-center justify-between">
                <div class="flex-1 min-w-0">
                  <div class="font-medium text-gray-900 truncate">
                    <%= link_to (task.title.presence || "Task ##{task.id}"), project_task_path(@project, task) %>
                  </div>
                  <% if task.description.present? %>
                    <p class="text-sm text-gray-500 mt-1 line-clamp-2">
                      <%= task.description %>
                    </p>
                  <% end %>
                </div>

                <div class="flex gap-3">
                  <%= link_to t('actions.edit'), edit_project_task_path(@project, task), class: 'btn btn-sm btn-outline' %>
                  <%= link_to t('actions.delete'), project_task_path(@project, task),
                              method: :delete,
                              data: { confirm: t('tasks.confirm_delete') || "Are you sure you want to delete this task?" },
                              class: 'btn btn-sm btn-danger' %>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    <% else %>
      <div class="text-center py-12 bg-gray-50 rounded-lg border border-gray-200">
        <h3 class="text-lg font-medium text-gray-900">
          <%= t('tasks.no_tasks') || "No tasks yet" %>
        </h3>
        <p class="mt-2 text-sm text-gray-500">
          <%= t('tasks.no_tasks_hint') || "Create your first task to get started." %>
        </p>
        <div class="mt-6">
          <% if current_user.can_contribute_to?(@project) %>
            <%= link_to t('tasks.new.title') || "New Task", new_project_task_path(@project), class: 'btn btn-amber' %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>