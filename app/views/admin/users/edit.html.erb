<% content_for :title, 'Edit User' %>

<div class="flex justify-between items-center mb-4">
  <h1>Edit User: <%= @user.display_name %></h1>
  <%= link_to 'Back to Users', admin_users_path, class: 'btn btn-outline' %>
</div>

<div class="form-card" style="max-width:480px;">
  <%= render 'shared/error_messages', object: @user %>

  <%= form_with model: [:admin, @user], local: true do |f| %>
    <div class="form-group">
      <%= f.label :name, 'Full Name', class: 'form-label' %>
      <%= f.text_field :name, class: 'form-control' %>
    </div>
    <div class="form-group">
      <%= f.label :email, 'Email', class: 'form-label' %>
      <%= f.email_field :email, class: 'form-control' %>
    </div>
    <div class="form-group">
      <div style="display:flex; align-items:center; gap:0.75rem; padding:0.75rem; background:var(--slate-50); border-radius:var(--radius); border:1.5px solid var(--slate-200);">
        <%= f.check_box :admin, class: 'form-check-input', id: 'user_admin' %>
        <%= f.label :admin, 'Administrator privileges', class: 'form-label', style: 'margin:0; cursor:pointer;' %>
      </div>
    </div>
    <div class="flex gap-3 mt-4">
      <%= f.submit 'Update User', class: 'btn btn-amber' %>
      <%= link_to 'Cancel', admin_users_path, class: 'btn btn-outline' %>
    </div>
  <% end %>
</div>
