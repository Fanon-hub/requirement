<% content_for :title, t('projects.index.title') %>

<div class="page-header">
  <div class="container">
    <div>
      <h1 class="page-title"><%= t('projects.index.title') %></h1>
      <p class="page-subtitle"><%= t('projects.index.subtitle') %></p>
    </div>
    <div class="page-actions">
      <%= link_to t('navigation.new_project'), new_project_path, class: 'btn btn-amber' %>
    </div>
  </div>
</div>

<div class="page-content">
  <div class="container">

    <!-- Search/Filter -->
      <div class="filter-bar mb-6">
        <%= search_form_for @q, url: projects_path, method: :get, class: "flex flex-wrap gap-4" do |f| %>
          <div class="flex-grow min-w-[200px]">
            <%= f.label :name_cont, t('actions.search'), class: 'form-label' %>
            <%= f.search_field :name_cont, 
                              class: 'form-control', 
                              placeholder: t('projects.index.search_placeholder') || 'Search projects...' %>
          </div>

          <div class="min-w-[180px]">
            <%= f.label :status_eq, t('projects.fields.status'), class: 'form-label' %>
            <%= f.select :status_eq, 
                        Project.statuses.keys.map { |s| [t("projects.statuses.#{s}"), s] }, 
                        { include_blank: t('projects.index.all_statuses') || 'All statuses' }, 
                        class: 'form-control' %>
          </div>

          <div class="self-end">
            <%= f.submit t('actions.filter'), class: 'btn btn-primary' %>
            <%= link_to t('actions.clear'), projects_path, class: 'btn btn-outline' %>
          </div>
        <% end %>
      </div>

    <% if @projects.empty? %>
      <div class="card">
        <div class="empty-state">
          <div class="empty-state-icon">📁</div>
          <h3><%= t('projects.index.empty') %></h3>
          <%= link_to t('navigation.new_project'), new_project_path, class: 'btn btn-amber' %>
        </div>
      </div>
    <% else %>
      <div class="grid-auto">
        <% @projects.each do |project| %>
          <div class="project-card">
            <div class="project-card-header">
              <div>
                <%= link_to project.name, project_path(project), class: 'project-name' %>
                <div style="margin-top:0.375rem;">
                  <span class="badge badge-<%= project.status %>"><%= t("projects.statuses.#{project.status}") %></span>
                </div>
              </div>
            </div>
            <div class="project-card-body">
              <p class="project-description"><%= project.description.presence || 'No description.' %></p>
              <div class="progress-wrap mt-3">
                <div class="progress-label">
                  <span>Completion</span>
                  <span><%= project.task_completion_rate %>%</span>
                </div>
                <div class="progress-bar">
                  <div class="progress-fill" style="width:<%= project.task_completion_rate %>%"></div>
                </div>
              </div>
            </div>
            <div class="project-card-footer">
              <div>
                <span class="text-xs text-muted">📋 <%= project.tasks.count %> tasks</span>
                <% if project.end_date %>
                  <span class="text-xs text-muted" style="margin-left:0.75rem;">📅 <%= project.end_date.strftime('%b %d') %></span>
                <% end %>
              </div>
              <div class="flex gap-2">
                <%= link_to t('actions.view'), project_path(project), class: 'btn btn-ghost btn-sm' %>
                <% if project.project_manager == current_user || current_user.admin? %>
                  <%= link_to t('actions.edit'), edit_project_path(project), class: 'btn btn-outline btn-sm' %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <div class="mt-4">
        <%= paginate @projects %>
      </div>
    <% end %>

  </div>
</div>
