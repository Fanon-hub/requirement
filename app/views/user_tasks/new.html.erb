<div style="max-width: 600px; margin: 0 auto; padding: 20px;">

  <h1 style="text-align: center; color: #333; margin-bottom: 30px;">New Task</h1>

  <% if @task.errors.any? %>
    <div id="error_explanation" style="background-color: #ffe6e6; padding: 15px; border-radius: 8px; margin-bottom: 20px; border: 1px solid #ffcccc;">
      <h2 style="color: #cc0000; margin-bottom: 10px;">
        <%= pluralize(@task.errors.count, "error") %> prohibited this task from being saved:
      </h2>
      <ul style="margin-left: 20px;">
        <% @task.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: [@project, @task], local: true, html: { style: "display: flex; flex-direction: column; gap: 15px;" } do |f| %>
    
    <div>
      <%= f.label :title, style: "font-weight: bold;" %><br>
      <%= f.text_field :title, style: "width: 100%; padding: 10px; border-radius: 6px; border: 1px solid #ccc;" %>
    </div>

    <div>
      <%= f.label :description, style: "font-weight: bold;" %><br>
      <%= f.text_area :description, rows: 5, style: "width: 100%; padding: 10px; border-radius: 6px; border: 1px solid #ccc;" %>
    </div>

    <div style="text-align: center; margin-top: 20px;">
      <%= f.submit "Create Task", style: "background-color: #4CAF50; color: white; padding: 10px 25px; border-radius: 6px; border: none; cursor: pointer; font-size: 16px;" %>
      <%= link_to "Cancel", project_tasks_path(@project), style: "margin-left: 10px; color: #555; text-decoration: none; padding: 10px 20px; border: 1px solid #ccc; border-radius: 6px;" %>
    </div>

  <% end %>
</div>