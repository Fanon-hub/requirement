<% content_for :title, t('projects.new.title') %>

<div class="page-header">
  <div class="container">
    <div>
      <div class="text-sm text-muted mb-1"><%= link_to t('navigation.projects'), projects_path %> /</div>
      <h1 class="page-title"><%= t('projects.new.title') %></h1>
      <p class="page-subtitle"><%= t('projects.new.subtitle') %></p>
    </div>
  </div>
</div>

<div class="page-content">
  <div class="container-sm">
    <div class="form-card">
      <%= form_with model: @project, url: projects_path, local: true do |f| %>
        <%= render 'form', f: f %>
        <hr class="divider">
        <div class="flex gap-3">
          <%= f.submit t('helpers.submit.create', model: 'Project'), class: 'btn btn-amber' %>
          <%= link_to t('actions.cancel'), projects_path, class: 'btn btn-outline' %>
        </div>
      <% end %>
    </div>
  </div>
</div>
